# Báo cáo do học viên tạo ra khi thực hành (không commit)
*.report.html
report.html
output/
.DS_Store
Thumbs.db

# VSCode
.vscode/

# Dữ liệu của dự án: không commit, mỗi học viên tự đặt vào máy mình
vanarsdel/data/raw/*
!vanarsdel/data/raw/.gitkeep
!vanarsdel/data/raw/VanArsdel_Budget.csv
vanarsdel/data/clean/*
!vanarsdel/data/clean/.gitkeep

# Power BI
# Dự án lưu dạng PBIP (thư mục file text), commit được và xem được lịch sử thay đổi.
# File .pbix là nhị phân, không commit.
*.pbix
# Thiết lập cục bộ và cache của PBIP, khác nhau theo máy nên không commit.
**/.pbi/localSettings.json
**/*.abf

# Thư mục làm việc: bản nháp và kết quả trung gian
vanarsdel/work/*
!vanarsdel/work/.gitkeep
day-1/work/*
!day-1/work/README.md
